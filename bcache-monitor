def draw_info(stdscr, state):
    scroll = 0
    while True:
        stdscr.erase()
        maxy, maxx = stdscr.getmaxyx()
        safe_addstr(stdscr, 0, 1, "INFO | Q/Esc back | ↑↓ scroll | PgUp/PgDn", 4)
        width = max(20, maxx - 4)
        wrapped = []
        for line in info_lines(state):
            if not line:
                wrapped.append("")
            else:
                wrapped.extend(textwrap.wrap(line, width=width) or [""])
        visible_h = max(1, maxy - 2)
        scroll = max(0, min(scroll, max(0, len(wrapped) - visible_h)))
        for idx, line in enumerate(wrapped[scroll:scroll + visible_h]):
            safe_addstr(stdscr, idx + 1, 1, line[:width], 0)
        if len(wrapped) > visible_h:
            safe_addstr(stdscr, maxy - 1, 1, f"{scroll + 1}-{min(scroll + visible_h, len(wrapped))}/{len(wrapped)}", 4)
        stdscr.refresh()
        ch = stdscr.getch()
        if ch in [27, ord('q'), ord('Q'), ord('i'), ord('I')]:
            return
        if ch in [curses.KEY_DOWN, ord('j')]:
            scroll += 1
        elif ch in [curses.KEY_UP, ord('k')]:
            scroll -= 1
        elif ch == curses.KEY_NPAGE:
            scroll += visible_h
        elif ch == curses.KEY_PPAGE:
            scroll -= visible_h

def draw_main(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)

    update_notice = ""
    updated_from = os.environ.get("BCACHE_MONITOR_UPDATED_FROM", "").strip()
    updated_to = os.environ.get("BCACHE_MONITOR_UPDATED_TO", "").strip()
    if updated_from and updated_to:
        update_notice = f"UPDATED: {updated_from} -> {updated_to}"

    config, config_notice = load_config()
    state = AppState(config=config, config_notice=config_notice, update_notice=update_notice, selected_containers=list(config.get("containers", [])), pt=time.time())
    refresh_device_selection(state)
    ph,pm=stats(state.device_path)
    if ph is None or pm is None:
        ph, pm = 0, 0
    state.ph, state.pm = ph, pm

    while True:
        stdscr.erase()
        maxy,maxx=stdscr.getmaxyx()

        refresh_device_selection(state)
        if not state.device_path:
            safe_addstr(stdscr, 0, 0, "No bcache device found (set BCACHE_MONITOR_DEVICE)", 1)
            if state.available_devices:
                safe_addstr(stdscr, 1, 0, f"Available: {', '.join(state.available_devices)}", 3)
            safe_addstr(stdscr, 2, 0, "Q=quit")
            stdscr.refresh()
            if stdscr.getch() in [ord('q'),ord('Q')]:
                break
            time.sleep(1)
            continue

        tiny_mode = maxy < 18 or maxx < 64
        compact_mode = maxy < 22 or maxx < 80
        narrow_mode = maxx < 120

        # DATA
        if not state.device_path:
            safe_addstr(stdscr,0,1,f"BCACHE OBSERVABILITY v{__version__}",4)
            safe_addstr(stdscr,2,1,"ERROR: No bcache device available.",1)
            safe_addstr(stdscr,3,1,"Expected a path like /sys/block/<device>/bcache.",3)
            safe_addstr(stdscr,4,1,"Please verify bcache is active and the device is attached.",3)
            safe_addstr(stdscr,maxy-1,1,"Q=quit")
            stdscr.refresh()
            if stdscr.getch() in [ord('q'),ord('Q')]:
                break
            time.sleep(1)
            continue

        h0,m0=stats(state.device_path)
        sysfs_ok = not (h0 is None or m0 is None)
        if not sysfs_ok:
            h0, m0 = state.ph, state.pm
        now=time.time()
        dt=max(now-state.pt, MIN_RATE_SAMPLE_SECONDS)

        hps=int((h0-state.ph)/dt); mps=int((m0-state.pm)/dt)
        state.ph,state.pm,state.pt=h0,m0,now
        state.hits.append(hps); state.miss.append(mps); state.miss_trend.append(mps)

        eff=h0/(h0+m0)*100 if (h0+m0) else 0
        eff_baseline = (sum(state.eff_history) / len(state.eff_history)) if state.eff_history else None
        state.eff_history.append(eff)
        details = read_bcache_details(state.device_name, state.device_path)
        if now - state.smart_last >= SMART_REFRESH_SECONDS or not state.smart_cache:
            state.smart_cache = read_ssd_health(details.get("cache_devices"))
            state.smart_last = now
        smart_health = state.smart_cache
        report = health_report(eff, details, smart_health, hps, mps)
        recs = recommendations(eff, details, smart_health)
        flush_seconds = estimate_flush_seconds(details.get("dirty_bytes"), details.get("writeback_rate_bytes") or state.backing_write_rate_bytes)
        backing_read_rate, backing_write_rate = calculate_device_rates(state.backing_io_prev, details.get("device_stat"), now)
        if details.get("device_stat"):
            state.backing_io_prev = (details["device_stat"], now)
        if backing_write_rate is not None:
            state.backing_write_rate_bytes = backing_write_rate
            state.backing_write_history.append(backing_write_rate)
        dirty_bytes = details["dirty_bytes"]
        dirty_display=format_dirty_value(dirty_bytes)

        # -------- HEADER --------
        safe_addstr(stdscr,0,1,f"HEADER | BCACHE OBSERVABILITY v{__version__} | DEVICE {state.device_name or 'N/A'}",6)

        # -------- KPI BLOCK --------
        ratio = (mps / hps) if hps > 0 else (float("inf") if mps > 0 else 0.0)
        ratio_text = "∞" if ratio == float("inf") else f"{ratio:.2f}"
        safe_addstr(stdscr,2,1,f"KPI   | SCORE {report['score']:3d}/100 {report['status']}   EFF {eff:.1f}% ({efficiency_label(eff)})   DIRTY {dirty_display}", 2 if report["score"] >= 80 else (3 if report["score"] >= 50 else 1))
        source_text = f"KPI   | LIVE HIT/s {hps}   MISS/s {mps}   SOURCE {state.device_source}"
        if maxx >= 96:
            source_text += " (config/env/auto)"
        safe_addstr(stdscr,3,1,source_text)

        # -------- GRAPH --------
        footer_reserved = 2
        graph_min_h = 4 if compact_mode else 6
        graph_max_fraction = 0.34 if narrow_mode else 0.32
        graph_max_h = 12 if compact_mode else 16
        # Make the container section visible earlier: fixed reserve for Health + container header/table.
        reserved_after_graph = 8 if compact_mode else (13 if narrow_mode else 12)
        graph_h = max(
            graph_min_h,
            min(
                maxy - reserved_after_graph - footer_reserved,
                int(maxy * graph_max_fraction),
                graph_max_h,
            ),
        )
        graph_y = 5
        graph_x = 8
        available_graph_w = maxx - graph_x - 1
        graph_w = max(1, available_graph_w)
        if available_graph_w >= 20:
            graph_w = max(20, graph_w)
        raw_maxv = max(max(state.hits) if state.hits else 0, max(state.miss) if state.miss else 0, 1)
        target_maxv = FIXED_MAX_PS if FIXED_MAX_PS > 0 else raw_maxv
        state.graph_scale = 0.35 * target_maxv + 0.65 * state.graph_scale
        maxv = max(int(state.graph_scale), 1)

        draw_y_markers(stdscr, graph_y, graph_x - 1, graph_h, maxv)
        draw_x_axis(stdscr, graph_y + graph_h - 1, graph_x, graph_w)
        draw_line_graph(stdscr, state.miss, graph_y, graph_x, graph_w, graph_h, 1, maxv)
        draw_line_graph(stdscr, state.hits, graph_y, graph_x, graph_w, graph_h, 2, maxv)
        if compact_mode:
            graph_legend = "GRAPH | red=MISS/s green=HIT/s"
        else:
            graph_legend = f"GRAPH | red=MISS/s | green=HIT/s | Scale {maxv}/s | ◆ latest non-zero | • history"
        safe_addstr(stdscr, graph_y - 1, graph_x, graph_legend, 6)
        info_y = graph_y + graph_h + 1
        point_help = "Points: 1 point = 1s | zero values stay on the axis to avoid fake traffic"
        safe_addstr(stdscr, info_y, graph_x, point_help, 6)
        info_y += 1

        avg_h = (sum(state.hits) / len(state.hits)) if state.hits else 0
        avg_m = (sum(state.miss) / len(state.miss)) if state.miss else 0
        max_h = max(state.hits) if state.hits else 0
        max_m = max(state.miss) if state.miss else 0
        miss_share = (mps / (hps + mps) * 100.0) if (hps + mps) > 0 else 0.0
        # Legend for values: current / average / peak
        h_part = f"H {hps:>4}/{avg_h:>4.0f}/{max_h:>4}"
        m_part = f"M {mps:>4}/{avg_m:>4.0f}/{max_m:>4}"
        hit_share = (hps / (hps + mps) * 100.0) if (hps + mps) > 0 else 0.0
        mix_part = f"MIX M:{miss_share:>5.1f}% H:{hit_share:>5.1f}%" if (hps + mps) > 0 else "MIX idle"
        delta_part = f"Δ M:{format_delta_pct_for_display(mps, avg_m)} H:{format_delta_pct_for_display(hps, avg_h)}"
        safe_addstr(stdscr, info_y, graph_x, h_part, 2)
        x_off = graph_x + len(h_part)
        safe_addstr(stdscr, info_y, x_off, " | ", 6)
        x_off += 3
        safe_addstr(stdscr, info_y, x_off, m_part, 1)
        x_off += len(m_part)
        safe_addstr(stdscr, info_y, x_off, f" | {mix_part} | {delta_part}", 6)
        info_y += 1
        safe_addstr(stdscr, info_y, graph_x, "H/M format: current/s / average/s / peak/s", 6)
        info_y += 1
        if not tiny_mode:
            safe_addstr(stdscr, info_y, graph_x, f"window {min(len(state.hits), graph_w)}s (buffer {HISTORY}s)", 6)
            info_y += 1

        # -------- STATUS --------
        status,color,reason=status_from_metrics(eff,hps,mps,state.miss_trend)
        safe_addstr(stdscr, info_y, 1, f"HEALTH | SCORE {report['score']}/100 {report['status']} | PRIMARY ALERT: {status} ({reason})", color)
        info_y += 1
        eff_arrow = trend_arrow(eff, eff_baseline) if eff_baseline is not None else "→"
        ratio_arrow = trend_arrow(mps, avg_m)
        if not tiny_mode:
            health_text = f"HEALTH | EFF {eff:.1f}%{eff_arrow} crit<{EFF_CRITICAL_THRESHOLD:.0f} | MISS/HIT {ratio_text}{ratio_arrow} crit≥{MISS_HIT_RATIO_CRITICAL:.2f}"
            safe_addstr(stdscr, info_y, 1, health_text, color)
            info_y += 1
        if len(state.hits) >= 10 and len(state.miss) >= 10:
            short_h = sum(list(state.hits)[-10:]) / 10
            short_m = sum(list(state.miss)[-10:]) / 10
        else:
            short_h = avg_h
            short_m = avg_m
        if not compact_mode:
            safe_addstr(stdscr, info_y, 1, f"10s AVG -> H:{short_h:.0f}/s  M:{short_m:.0f}/s  ΔMISS:{format_delta_pct_for_display(short_m, avg_m)} vs window", 4)
            info_y += 1

        if compact_mode:
            safe_addstr(stdscr, graph_y + graph_h + 4, 1, tr(state, "compact_mode"), 3)
            if state.update_notice: safe_addstr(stdscr,maxy-2,1,state.update_notice,3)
            if state.config_notice: safe_addstr(stdscr,maxy-2,1,state.config_notice,3)
            elif state.device_warning: safe_addstr(stdscr,maxy-2,1,state.device_warning,3)
            safe_addstr(stdscr,maxy-1,1,tr(state, "footer"),4)
            stdscr.refresh()
            action = handle_keypress(stdscr.getch(), state)
            if action == "quit": break
            if action == "settings": draw_settings(stdscr, state)
            if action == "info": draw_info(stdscr, state)
            time.sleep(FRAME_SECONDS)
            continue

        # -------- CONTAINERS --------
        y = max(info_y + 1, graph_y + graph_h + 5)
        stats_right_x = 32 if maxx >= 100 else max(1, maxx // 2)
        safe_addstr(stdscr,y,1,tr(state, "cache_numbers"),4)
        y += 1
        safe_addstr(stdscr,y,1,f"{tr(state, 'total_hits')}:   {h0:,}")
        safe_addstr(stdscr,y,stats_right_x,f"{tr(state, 'total_misses')}: {m0:,}")
        y += 1
        safe_addstr(stdscr,y,1,f"{tr(state, 'efficiency')}:   {eff:6.2f}%")
        safe_addstr(stdscr,y,stats_right_x,f"Miss/Hit:     {ratio_text}")
        y += 1
        safe_addstr(stdscr,y,1,f"{tr(state, 'peak_hit')}:   {max_h:>6}")
        safe_addstr(stdscr,y,stats_right_x,f"{tr(state, 'peak_miss')}:  {max_m:>6}")
        y += 1
        safe_addstr(stdscr,y,1,f"{tr(state, 'mode')}:         {format_cache_mode(details['cache_mode'])}")
        safe_addstr(stdscr,y,stats_right_x,f"{tr(state, 'wb_target')}:    {format_io_rate(details['writeback_rate_bytes'])}")
        y += 1
        safe_addstr(stdscr,y,1,f"{tr(state, 'flush_eta')}:    {format_duration(flush_seconds)}")
        safe_addstr(stdscr,y,stats_right_x,f"{tr(state, 'ssd_life')}:     {format_pct(smart_health.get('life_remaining_percent'))}")
        y += 1
        safe_addstr(stdscr,y,1,f"{tr(state, 'ssd_temp')}:     {(str(smart_health.get('temperature_c')) + ' °C') if smart_health.get('temperature_c') is not None else 'N/A'}")
        safe_addstr(stdscr,y,stats_right_x,f"{tr(state, 'ssd_tbw')}:      {format_bytes(smart_health.get('tbw_bytes'))}")
        y += 1
        safe_addstr(stdscr,y,1,f"{tr(state, 'wb_percent')}:   {details['writeback_percent'] or 'N/A'}")
        safe_addstr(stdscr,y,stats_right_x,f"{tr(state, 'hdd_write')}:    {format_io_rate(state.backing_write_rate_bytes)}")
        y += 1
        safe_addstr(stdscr,y,1,f"{tr(state, 'wb_running')}:   {details['writeback_running'] or 'N/A'}")
        y += 1
        safe_addstr(stdscr,y,1,f"{tr(state, 'ssd_cache')}:    {format_bytes(details['cache_capacity'])}")
        safe_addstr(stdscr,y,stats_right_x,f"{tr(state, 'avail_wb')}:     {format_pct(details['cache_available_percent'])} {format_bytes(details['cache_available_bytes'])}")
        y += 1
        fs_usage = details['fs_usage']
        hdd_text = format_bytes(fs_usage['total']) if fs_usage else format_bytes(details['backing_size'])
        hdd_used = f"used {format_bytes(fs_usage['used'])} free {format_bytes(fs_usage['free'])}" if fs_usage else "used/free N/A"
        safe_addstr(stdscr,y,1,f"{tr(state, 'hdd_backing')}:  {hdd_text}")
        safe_addstr(stdscr,y,stats_right_x,hdd_used)
        y += 1
        if y < maxy - 5:
            safe_addstr(stdscr,y,1,(tr(state, "recommend") + ": " + recs[0])[:maxx-2],3 if report["score"] < 80 else 2)
            y += 1
        diag = automatic_diagnosis(state.eff_history, eff, hps, mps, details, smart_health, state.docker_io_rates)
        anomaly = detect_anomalies(list(state.backing_write_history)[:-1], state.backing_write_rate_bytes)
        if y < maxy - 6:
            safe_addstr(stdscr,y,1,(tr(state, "diagnosis_title") + ": " + (diag["recommendation"] if diag["problem"] else tr(state, "no_problem")))[:maxx-2],3 if diag["problem"] else 2)
            y += 1
        if anomaly.get("anomaly") and y < maxy - 6:
            safe_addstr(stdscr,y,1,("ANOMALY: " + anomaly["message"])[:maxx-2],1)
            y += 1
        if y < maxy - 6:
            guard = maintenance_guard(details, smart_health)
            safe_addstr(stdscr,y,1,("MAINTENANCE: " + guard["message"])[:maxx-2],2 if guard["safe"] else 3)
            y += 1
        y += 1
        safe_addstr(stdscr,y,1,tr(state, "containers_title"),4)
        y+=1

        docker_refreshed = now - state.docker_last >= DOCKER_REFRESH_SECONDS
        if docker_refreshed:
            state.docker_cache, state.docker_state = list_container_stats_for_state(state)
            try:
                append_history_sample(HISTORY_CSV_PATH, state.device_name, eff, details, smart_health, now)
            except OSError:
                pass
            state.docker_last = now

        selection_label = f"{len(state.selected_containers)} {tr(state, 'selected')}" if state.selected_containers else tr(state, "all_empty_selection")
        safe_addstr(stdscr, y, 1, f"{tr(state, 'containers_title')}: {selection_label}", 4)
        y += 1
        data_line = f"{tr(state, 'data')}: SYSFS {'OK' if sysfs_ok else tr(state, 'missing')} | DOCKER {state.docker_state}"
        if narrow_mode:
            safe_addstr(stdscr, y, 1, data_line, 4)
