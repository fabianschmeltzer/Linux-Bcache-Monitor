    return "\n".join(lines) + "\n"

def format_pct(value):
    return "N/A" if value is None else f"{value:.1f}%"


def format_cache_mode(cache_mode_raw):
    if not cache_mode_raw:
        return "N/A"

    token = str(cache_mode_raw).strip()
    for part in token.split():
        if part.startswith("[") and part.endswith("]"):
            active_mode = part.strip("[]").strip()
            if active_mode:
                return active_mode

    return token


def format_delta_pct(current, baseline, min_baseline=0.0):
    if baseline <= min_baseline:
        return "n/a"
    return f"{pct_change(current, baseline):+.0f}%"


def format_delta_pct_for_display(current, baseline):
    if current <= 0 and baseline <= MIN_DELTA_BASELINE_PS:
        return "n/a"
    return format_delta_pct(current, baseline, MIN_DELTA_BASELINE_PS)

def list_bcache_devices():
    candidates = []
    for path in sorted(glob.glob("/sys/block/*/bcache")):
        if os.path.isdir(path):
            device = os.path.basename(os.path.dirname(path))
            if device:
                candidates.append((device, path))
    return candidates


def resolve_bcache_device(config_device=""):
    candidates = list_bcache_devices()
    devices = [device for device, _ in candidates]
    device_map = {device: path for device, path in candidates}

    if not candidates:
        return {
            "device": None,
            "path": None,
            "source": "none",
            "devices": devices,
            "warning": "No bcache device found (expected: /sys/block/*/bcache).",
        }

    env_device = os.environ.get("BCACHE_MONITOR_DEVICE", "").strip()
    config_device = (config_device or "").strip()

    if config_device:
        if config_device in device_map:
            return {"device": config_device, "path": device_map[config_device], "source": "config", "devices": devices, "warning": ""}
        first_device = devices[0]
        return {
            "device": first_device,
            "path": device_map[first_device],
            "source": "auto",
            "devices": devices,
            "warning": f"Saved device '{config_device}' not found; automatic fallback enabled.",
        }

    if env_device and env_device in device_map:
        return {"device": env_device, "path": device_map[env_device], "source": "env", "devices": devices, "warning": ""}

    first_device = devices[0]
    warning = f"Env device '{env_device}' not found; automatic fallback enabled." if env_device else ""
    return {"device": first_device, "path": device_map[first_device], "source": "auto", "devices": devices, "warning": warning}


def default_config():
    return {
        "containers": list(DEFAULT_CONFIG["containers"]),
        "bcache_device": DEFAULT_CONFIG["bcache_device"],
        "language": DEFAULT_CONFIG["language"],
        "docker_enabled": DEFAULT_CONFIG["docker_enabled"],
    }


def _sanitize_config(raw):
    cfg = default_config()
    if not isinstance(raw, dict):
        return cfg

    containers = raw.get("containers")
    if isinstance(containers, list):
        cleaned = []
        seen = set()
        for item in containers:
            if not isinstance(item, str):
                continue
            name = item.strip()
            if not name or name in seen:
                continue
            seen.add(name)
            cleaned.append(name)
        cfg["containers"] = cleaned

    dev = raw.get("bcache_device")
    if isinstance(dev, str):
        cfg["bcache_device"] = dev.strip()

    language = raw.get("language")
    if isinstance(language, str) and language.strip().lower() in ("de", "en"):
        cfg["language"] = language.strip().lower()

    docker_enabled = raw.get("docker_enabled")
    if isinstance(docker_enabled, bool):
        cfg["docker_enabled"] = docker_enabled

    return cfg


def load_config():
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as src:
            return _sanitize_config(json.load(src)), ""
    except FileNotFoundError:
        cfg = default_config()
        ok, msg = save_config(cfg)
        return cfg, ("Config not found; defaults created." if ok else f"Config missing ({msg})")
    except PermissionError:
        return default_config(), "Config not readable (permissions)."
    except json.JSONDecodeError:
        return default_config(), "Config is invalid (JSON). Using defaults."
    except OSError as exc:
        return default_config(), f"Config read failed: {exc}"


def save_config(config):
    cfg = _sanitize_config(config)
    directory = os.path.dirname(CONFIG_PATH)
    temp_path = f"{CONFIG_PATH}.tmp"
    try:
        os.makedirs(directory, exist_ok=True)
        with open(temp_path, "w", encoding="utf-8") as dst:
            json.dump(cfg, dst, indent=2, ensure_ascii=False)
            dst.write("\n")
            dst.flush()
            os.fsync(dst.fileno())
        os.replace(temp_path, CONFIG_PATH)
        return True, ""
    except PermissionError:
        return False, "No write permission for config."
    except OSError as exc:
        return False, str(exc)
    finally:
        try:
            if os.path.exists(temp_path):
                os.remove(temp_path)
        except OSError:
            pass


def _run_command(command, timeout=2.0):
    try:
        cp = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
        if cp.returncode != 0:
            return {"ok": False, "status": f"ERR:{cp.returncode}", "stdout": cp.stdout, "stderr": cp.stderr}
        return {"ok": True, "status": "OK", "stdout": cp.stdout, "stderr": cp.stderr}
    except subprocess.TimeoutExpired:
        return {"ok": False, "status": "TIMEOUT", "stdout": "", "stderr": ""}
    except FileNotFoundError:
        return {"ok": False, "status": "NOT INSTALLED", "stdout": "", "stderr": ""}


def list_running_containers():
    result = _run_command(["docker", "ps", "--format", "{{.Names}}"], timeout=2.0)
    if not result["ok"]:
        return [], result["status"]
    names = [line.strip() for line in result["stdout"].splitlines() if line.strip()]
    return names, result["status"]


def _normalize_container_name(name):
    return str(name or "").strip().lstrip("/")


def _parse_stats_output(stdout, selected=None):
    entries = []
    for line in stdout.splitlines():
        parts = line.split("|")
        if len(parts) != 5:
            continue
        name, cpu_raw, mem_raw, mem_usage_raw, block_io_raw = parts
        normalized = _normalize_container_name(name)
        if selected and normalized not in selected:
            continue

        cpu = _parse_percent(cpu_raw)
        mem = _parse_percent(mem_raw)
        if cpu is None or mem is None:
            continue
        entries.append((normalized or name, cpu, mem, mem_usage_raw.strip(), block_io_raw.strip()))
    return entries



def calculate_docker_io_rates(prev_sample, read_bytes, write_bytes, now_ts):
    current_totals = ((read_bytes or 0, write_bytes or 0), now_ts)
    if not prev_sample:
        return None, None, current_totals
    prev_totals, prev_ts = prev_sample
    if isinstance(prev_totals, tuple):
        prev_read, prev_write = prev_totals
    else:
        prev_read, prev_write = prev_totals, 0
    elapsed = now_ts - prev_ts
    read_delta = (read_bytes or 0) - prev_read
    write_delta = (write_bytes or 0) - prev_write
    read_rate = read_delta / elapsed if elapsed > 0 and read_delta >= 0 else None
    write_rate = write_delta / elapsed if elapsed > 0 and write_delta >= 0 else None
    return read_rate, write_rate, current_totals

def list_container_stats(selected_containers):
    selected = sorted({_normalize_container_name(name) for name in (selected_containers or []) if _normalize_container_name(name)})
    format_args = ["--no-stream", "--format", "{{.Name}}|{{.CPUPerc}}|{{.MemPerc}}|{{.MemUsage}}|{{.BlockIO}}"]

    selected_filter = None
    if selected:
        running_names, running_state = list_running_containers()
        if running_state != "OK":
            return [], running_state
        running_set = {_normalize_container_name(name) for name in running_names}
        selected = [name for name in selected if name in running_set]
        selected_filter = set(selected)
        if not selected:
            return [], "NO CONTAINERS"

    command = ["docker", "stats", *format_args]
    if selected:
        command.extend(selected)

    result = _run_command(command, timeout=2.5)
    if not result["ok"]:
        return [], result["status"]

    res = _parse_stats_output(result["stdout"], selected=selected_filter)

    if res:
        return res, "OK"

    return [], ("NO CONTAINERS" if selected_filter else "ALL (none running)")


def docker_enabled(config_or_state):
    config = getattr(config_or_state, "config", config_or_state) or {}
    return bool(config.get("docker_enabled", DEFAULT_CONFIG["docker_enabled"]))


def list_container_stats_for_state(state):
    if not docker_enabled(state):
        return [], tr(state, "docker_disabled_state")
    return list_container_stats(state.selected_containers)

STATS_TOTAL_PATH = None


def _discover_stats_total_path(bcache_path=None):
    if bcache_path:
        direct = os.path.join(bcache_path, "stats_total")
        if os.path.isdir(direct):
            return direct

    for root, dirs, _ in os.walk("/sys/fs/bcache"):
        if "stats_total" in dirs:
            return os.path.join(root, "stats_total")
    return ""


def stats(bcache_path=None):
    global STATS_TOTAL_PATH
    if bcache_path:
        STATS_TOTAL_PATH = _discover_stats_total_path(bcache_path)
    elif STATS_TOTAL_PATH is None:
        STATS_TOTAL_PATH = _discover_stats_total_path()

    if not STATS_TOTAL_PATH:
        return None, None

    h = read(f"{STATS_TOTAL_PATH}/cache_hits")
    m = read(f"{STATS_TOTAL_PATH}/cache_misses")

    if h is None or m is None:
        STATS_TOTAL_PATH = None
        return None, None

    return int(h), int(m)

def _parse_percent(raw):
    if raw is None:
        return None
    token = str(raw).strip().replace("%", "").replace(",", ".")
    if not token:
        return None
    try:
        return float(token)
    except ValueError:
        return None


