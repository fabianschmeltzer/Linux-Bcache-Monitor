        safe_addstr(stdscr, y, mem_x, tr(state, "ram"), 4)
        safe_addstr(stdscr, y, io_x, tr(state, "disk"), 4)
        y += 1
        if (maxy - 2) - y < 1:
            safe_addstr(stdscr, y, table_start_x, tr(state, "not_enough_space"), 3)
        now_ts = time.time()
        current_io_totals = {}
        for name,cpu,mem,mem_usage_raw,block_io_raw in state.docker_cache:
            if y+1 >= maxy:
                break
            cpu_room = max(0, cpu_col_w - 10)
            mem_room = max(0, mem_col_w - 11)
            mem_bytes = parse_docker_mem_usage_bytes(mem_usage_raw)
            mem_text = format_dirty_value(mem_bytes) if mem_bytes is not None else "N/A"
            read_bytes, write_bytes = parse_docker_block_io_pair(block_io_raw)

            read_rate, write_rate = state.docker_io_rates.get(name, (None, None))
            if docker_refreshed and (read_bytes is not None or write_bytes is not None):
                read_rate, write_rate, totals_sample = calculate_docker_io_rates(
                    state.docker_io_prev.get(name), read_bytes, write_bytes, now_ts
                )
                current_io_totals[name] = totals_sample
                state.docker_io_rates[name] = (read_rate, write_rate)
            if io_col_w >= 26:
                io_text = f"R {format_io_rate(read_rate)} W {format_io_rate(write_rate)}"
            else:
                total_rate = None if read_rate is None and write_rate is None else (read_rate or 0) + (write_rate or 0)
                io_text = format_io_rate(total_rate)
            bar_cpu, bar_cpu_empty = draw_meter(cpu, cpu_room, 2, empty_char=" ")
            bar_mem, bar_mem_empty = draw_meter(mem, mem_room, 3, empty_char=" ")

            max_name_len = max(6, name_col_w - 2)
            disp_name = name if len(name) <= max_name_len else name[:max_name_len-1] + "…"
            safe_addstr(stdscr,y,table_start_x,f"{disp_name:<{name_col_w-1}}")
            safe_addstr(stdscr,y,cpu_x,f"C {cpu:5.1f}% ",6)
            safe_addstr(stdscr,y,cpu_x + 9,bar_cpu,2)
            safe_addstr(stdscr,y,cpu_x + 9 + len(bar_cpu),bar_cpu_empty,6)
            safe_addstr(stdscr,y,mem_x,f"R {mem_text:>8} ",6)
            safe_addstr(stdscr,y,mem_x + 11,bar_mem,3)
            safe_addstr(stdscr,y,mem_x + 11 + len(bar_mem),bar_mem_empty,6)
            safe_addstr(stdscr,y,io_x,f"D {io_text}",6)
            y+=1
        if docker_refreshed:
            state.docker_io_prev = current_io_totals

        if state.update_notice: safe_addstr(stdscr,maxy-2,1,state.update_notice,3)
        if state.config_notice: safe_addstr(stdscr,maxy-2,1,state.config_notice,3)
        elif state.device_warning: safe_addstr(stdscr,maxy-2,1,state.device_warning,3)
        safe_addstr(stdscr,maxy-1,1,tr(state, "footer"),4)

        stdscr.refresh()

        key = stdscr.getch()
        if key == curses.KEY_RESIZE:
            continue
        action = handle_keypress(key, state)
        if action == "quit": break
        if action == "settings": draw_settings(stdscr, state)
        if action == "info": draw_info(stdscr, state)

        time.sleep(FRAME_SECONDS)


def print_prometheus_and_exit_if_requested(argv):
    if not any(arg in ("--prometheus", "--metrics") for arg in argv[1:]):
        return False
    config, _notice = load_config()
    resolution = resolve_bcache_device(config.get("bcache_device", ""))
    global BCACHE
    BCACHE = resolution.get("path") or ""
    h0, m0 = stats()
    h0 = h0 or 0
    m0 = m0 or 0
    eff = h0 / (h0 + m0) * 100 if (h0 + m0) else 0.0
    details = read_bcache_details(resolution.get("device"), resolution.get("path")) if resolution.get("path") else {
        "cache_mode": None, "dirty_bytes": 0, "cache_available_percent": None, "writeback_rate_bytes": None,
    }
    smart_health = read_ssd_health(details.get("cache_devices", []))
    report = health_report(eff, details, smart_health)
    print(prometheus_metrics(resolution.get("device"), eff, details, smart_health, report), end="")
    return True

def print_version_and_exit_if_requested(argv):
    if any(arg in ("--version", "-V") for arg in argv[1:]):
        print(__version__)
        return True
    return False


def main():
    if print_version_and_exit_if_requested(sys.argv):
        return
    if print_prometheus_and_exit_if_requested(sys.argv):
        return

    updated_from = os.environ.get("BCACHE_MONITOR_UPDATED_FROM")
    updated_to = os.environ.get("BCACHE_MONITOR_UPDATED_TO")
    if updated_from and updated_to:
        print_update_event(f"Update erfolgreich angewendet: {updated_from} -> {updated_to}")
        time.sleep(1)

    self_update_if_needed()
    curses.wrapper(init)

def init(stdscr):
    curses.start_color()
    curses.init_pair(1,curses.COLOR_RED,curses.COLOR_BLACK)
    curses.init_pair(2,curses.COLOR_GREEN,curses.COLOR_BLACK)
    curses.init_pair(3,curses.COLOR_YELLOW,curses.COLOR_BLACK)
    curses.init_pair(4,curses.COLOR_CYAN,curses.COLOR_BLACK)
    curses.init_pair(6,curses.COLOR_WHITE,curses.COLOR_BLACK)
    draw_main(stdscr)

if __name__=="__main__":
    main()
