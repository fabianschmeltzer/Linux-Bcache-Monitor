def read_int_file(path):
    raw = read(path)
    if raw is None:
        return None
    try:
        return int(str(raw).strip())
    except ValueError:
        return None


def read_block_device_size_bytes(device_name):
    if not device_name:
        return None
    sectors = read_int_file(f"/sys/block/{device_name}/size")
    if sectors is None:
        return None
    return sectors * 512


def disk_usage_for_device(device_name):
    if not device_name:
        return None
    mount_candidates = []
    try:
        with open("/proc/mounts", "r", encoding="utf-8") as src:
            for line in src:
                parts = line.split()
                if len(parts) < 2:
                    continue
                dev, mountpoint = parts[0], parts[1].replace("\040", " ")
                if dev == f"/dev/{device_name}" or dev.startswith(f"/dev/{device_name}p"):
                    mount_candidates.append(mountpoint)
    except OSError:
        return None
    if not mount_candidates:
        return None
    mountpoint = sorted(mount_candidates, key=len)[0]
    try:
        usage = shutil.disk_usage(mountpoint)
        return {"mountpoint": mountpoint, "total": usage.total, "used": usage.used, "free": usage.free}
    except OSError:
        return None


def discover_cache_set_path(bcache_path):
    if not bcache_path:
        return ""
    direct = os.path.join(bcache_path, "cache")
    if os.path.exists(direct):
        try:
            real = os.path.realpath(direct)
            if os.path.isdir(real):
                return real
        except OSError:
            pass

    stats_path = STATS_TOTAL_PATH or _discover_stats_total_path()
    if stats_path:
        parent = os.path.dirname(stats_path)
        if os.path.isdir(parent):
            return parent

    candidates = sorted(glob.glob("/sys/fs/bcache/*"))
    return candidates[0] if candidates else ""


def read_cache_device_capacity(cache_set_path):
    if not cache_set_path:
        return None
    capacities = []
    for cache_path in sorted(glob.glob(os.path.join(cache_set_path, "cache*"))):
        bucket_size = parse_sysfs_size_bytes(read(os.path.join(cache_path, "bucket_size")))
        buckets = read_int_file(os.path.join(cache_path, "nbuckets"))
        if bucket_size is not None and buckets is not None:
            capacities.append(bucket_size * buckets)
        else:
            dev_name = os.path.basename(os.path.realpath(cache_path))
            capacities.append(read_block_device_size_bytes(dev_name))
    known = [value for value in capacities if value is not None]
    return sum(known) if known else None


def read_bcache_details(device_name, bcache_path):
    cache_set_path = discover_cache_set_path(bcache_path)
    dirty_bytes = dirty_val()
    cache_capacity = read_cache_device_capacity(cache_set_path)
    cache_available_percent = _parse_percent(read(f"{bcache_path}/cache_available_percent")) if bcache_path else None
    if cache_available_percent is None and cache_set_path:
        cache_available_percent = _parse_percent(read(os.path.join(cache_set_path, "cache_available_percent")))

    cache_available_bytes = None
    if cache_capacity is not None and cache_available_percent is not None:
        cache_available_bytes = cache_capacity * (cache_available_percent / 100.0)

    backing_size = read_block_device_size_bytes(device_name)
    fs_usage = disk_usage_for_device(device_name)
    writeback_rate_sectors = read_int_file(f"{bcache_path}/writeback_rate") if bcache_path else None
    writeback_rate_bytes = writeback_rate_sectors * 512 if writeback_rate_sectors is not None else None

    return {
        "cache_mode": read(f"{bcache_path}/cache_mode") if bcache_path else None,
        "cache_capacity": cache_capacity,
        "cache_available_percent": cache_available_percent,
        "cache_available_bytes": cache_available_bytes,
        "dirty_bytes": dirty_bytes,
        "backing_size": backing_size,
        "fs_usage": fs_usage,
        "writeback_percent": read(f"{bcache_path}/writeback_percent") if bcache_path else None,
        "writeback_rate_bytes": writeback_rate_bytes,
        "writeback_running": read(f"{bcache_path}/writeback_running") if bcache_path else None,
        "cache_set_path": cache_set_path,
    }


def format_pct(value):
    return "N/A" if value is None else f"{value:.1f}%"


def format_cache_mode(cache_mode_raw):
    if not cache_mode_raw:
        return "N/A"

    token = str(cache_mode_raw).strip()
    for part in token.split():
        if part.startswith("[") and part.endswith("]"):
            active_mode = part.strip("[]").strip()
            if active_mode:
                return active_mode

    return token


def format_delta_pct(current, baseline):
    if baseline <= 0:
        return "n/a"
    return f"{pct_change(current, baseline):+.0f}%"

def list_bcache_devices():
    candidates = []
    for path in sorted(glob.glob("/sys/block/*/bcache")):
        if os.path.isdir(path):
            device = os.path.basename(os.path.dirname(path))
            if device:
                candidates.append((device, path))
    return candidates


def resolve_bcache_device(config_device=""):
    candidates = list_bcache_devices()
    devices = [device for device, _ in candidates]
    device_map = {device: path for device, path in candidates}

    if not candidates:
        return {
            "device": None,
            "path": None,
            "source": "none",
            "devices": devices,
            "warning": "Kein bcache-Gerät gefunden (erwartet: /sys/block/*/bcache).",
        }

    env_device = os.environ.get("BCACHE_MONITOR_DEVICE", "").strip()
    config_device = (config_device or "").strip()

    if config_device:
        if config_device in device_map:
            return {"device": config_device, "path": device_map[config_device], "source": "config", "devices": devices, "warning": ""}
        first_device = devices[0]
        return {
            "device": first_device,
            "path": device_map[first_device],
            "source": "auto",
            "devices": devices,
            "warning": f"Gespeichertes Device '{config_device}' nicht gefunden; Auto-Fallback aktiv.",
        }

    if env_device and env_device in device_map:
        return {"device": env_device, "path": device_map[env_device], "source": "env", "devices": devices, "warning": ""}

    first_device = devices[0]
    warning = f"Env-Device '{env_device}' nicht gefunden; Auto-Fallback aktiv." if env_device else ""
    return {"device": first_device, "path": device_map[first_device], "source": "auto", "devices": devices, "warning": warning}


def default_config():
    return {
        "containers": list(DEFAULT_CONFIG["containers"]),
        "bcache_device": DEFAULT_CONFIG["bcache_device"],
    }


def _sanitize_config(raw):
    cfg = default_config()
    if not isinstance(raw, dict):
        return cfg

    containers = raw.get("containers")
    if isinstance(containers, list):
        cleaned = []
        seen = set()
        for item in containers:
            if not isinstance(item, str):
                continue
            name = item.strip()
            if not name or name in seen:
                continue
            seen.add(name)
            cleaned.append(name)
        cfg["containers"] = cleaned

    dev = raw.get("bcache_device")
    if isinstance(dev, str):
        cfg["bcache_device"] = dev.strip()

    return cfg


def load_config():
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as src:
            return _sanitize_config(json.load(src)), ""
    except FileNotFoundError:
        cfg = default_config()
        ok, msg = save_config(cfg)
        return cfg, ("Config nicht gefunden; Defaults erstellt." if ok else f"Config fehlt ({msg})")
    except PermissionError:
        return default_config(), "Config nicht lesbar (Berechtigungen)."
    except json.JSONDecodeError:
        return default_config(), "Config defekt (JSON). Defaults genutzt."
    except OSError as exc:
        return default_config(), f"Config-Lesen fehlgeschlagen: {exc}"


def save_config(config):
    cfg = _sanitize_config(config)
    directory = os.path.dirname(CONFIG_PATH)
    temp_path = f"{CONFIG_PATH}.tmp"
    try:
        os.makedirs(directory, exist_ok=True)
        with open(temp_path, "w", encoding="utf-8") as dst:
            json.dump(cfg, dst, indent=2, ensure_ascii=False)
            dst.write("\n")
            dst.flush()
            os.fsync(dst.fileno())
        os.replace(temp_path, CONFIG_PATH)
        return True, ""
    except PermissionError:
        return False, "Keine Schreibberechtigung für Config."
    except OSError as exc:
        return False, str(exc)
    finally:
        try:
            if os.path.exists(temp_path):
                os.remove(temp_path)
        except OSError:
            pass


def _run_command(command, timeout=2.0):
    try:
        cp = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
        if cp.returncode != 0:
            return {"ok": False, "status": f"ERR:{cp.returncode}", "stdout": cp.stdout, "stderr": cp.stderr}
        return {"ok": True, "status": "OK", "stdout": cp.stdout, "stderr": cp.stderr}
    except subprocess.TimeoutExpired:
        return {"ok": False, "status": "TIMEOUT", "stdout": "", "stderr": ""}
    except FileNotFoundError:
        return {"ok": False, "status": "NOT INSTALLED", "stdout": "", "stderr": ""}


def list_running_containers():
    result = _run_command(["docker", "ps", "--format", "{{.Names}}"], timeout=2.0)
    if not result["ok"]:
        return [], result["status"]
    names = [line.strip() for line in result["stdout"].splitlines() if line.strip()]
    return names, result["status"]


def _normalize_container_name(name):
    return str(name or "").strip().lstrip("/")


def _parse_stats_output(stdout, selected=None):
    entries = []
    for line in stdout.splitlines():
        parts = line.split("|")
        if len(parts) != 5:
            continue
        name, cpu_raw, mem_raw, mem_usage_raw, block_io_raw = parts
        normalized = _normalize_container_name(name)
        if selected and normalized not in selected:
            continue

        cpu = _parse_percent(cpu_raw)
        mem = _parse_percent(mem_raw)
        if cpu is None or mem is None:
            continue
        entries.append((normalized or name, cpu, mem, mem_usage_raw.strip(), block_io_raw.strip()))
    return entries


def list_container_stats(selected_containers):
    selected = sorted({_normalize_container_name(name) for name in (selected_containers or []) if _normalize_container_name(name)})
    format_args = ["--no-stream", "--format", "{{.Name}}|{{.CPUPerc}}|{{.MemPerc}}|{{.MemUsage}}|{{.BlockIO}}"]

    command = ["docker", "stats", *format_args]
    if selected:
        command.extend(selected)

    result = _run_command(command, timeout=2.5)
    if not result["ok"]:
        return [], result["status"]

    selected_filter = set(selected) if selected else None
    res = _parse_stats_output(result["stdout"], selected=selected_filter)

    if res:
        return res, "OK"

    return [], ("NO CONTAINERS" if selected else "ALL (none running)")

STATS_TOTAL_PATH = None


def _discover_stats_total_path():
    for root, dirs, _ in os.walk("/sys/fs/bcache"):
        if "stats_total" in dirs:
            return os.path.join(root, "stats_total")
    return ""


def stats():
    global STATS_TOTAL_PATH
    if STATS_TOTAL_PATH is None:
        STATS_TOTAL_PATH = _discover_stats_total_path()

    if not STATS_TOTAL_PATH:
        return None, None

    h = read(f"{STATS_TOTAL_PATH}/cache_hits")
    m = read(f"{STATS_TOTAL_PATH}/cache_misses")

    if h is None or m is None:
        STATS_TOTAL_PATH = None
        return None, None

    return int(h), int(m)

def _parse_percent(raw):
    if raw is None:
        return None
    token = str(raw).strip().replace("%", "").replace(",", ".")
    if not token:
        return None
    try:
        return float(token)
    except ValueError:
        return None


