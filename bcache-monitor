def read_int_file(path):
    raw = read(path)
    if raw is None:
        return None
    try:
        return int(str(raw).strip())
    except ValueError:
        return None


def read_block_device_size_bytes(device_name):
    if not device_name:
        return None
    sectors = read_int_file(f"/sys/block/{device_name}/size")
    if sectors is None:
        return None
    return sectors * 512


def _decode_mount_field(value):
    return (
        str(value)
        .replace("\\040", " ")
        .replace("\\011", "\t")
        .replace("\\012", "\n")
        .replace("\\134", "\\")
    )

def _device_matches(candidate, device_name):
    if not candidate or not device_name or not candidate.startswith("/dev/"):
        return False
    target = os.path.realpath(f"/dev/{device_name}")
    real_candidate = os.path.realpath(candidate)
    return real_candidate == target or real_candidate.startswith(f"{target}p")


def _parse_mountinfo_lines(lines, device_name):
    matches = []
    for line in lines:
        if " - " not in line:
            continue
        left, right = line.rstrip("\n").split(" - ", 1)
        left_parts = left.split()
        right_parts = right.split()
        if len(left_parts) < 5 or len(right_parts) < 2:
            continue
        mountpoint = _decode_mount_field(left_parts[4])
        source = _decode_mount_field(right_parts[1])
        if _device_matches(source, device_name):
            matches.append((mountpoint, source))
    return matches


def disk_usage_for_device(device_name):
    if not device_name:
        return None
    mount_candidates = []
    try:
        with open("/proc/self/mountinfo", "r", encoding="utf-8") as src:
            mount_candidates = _parse_mountinfo_lines(src, device_name)
    except OSError:
        mount_candidates = []

    if not mount_candidates:
        try:
            with open("/proc/mounts", "r", encoding="utf-8") as src:
                for line in src:
                    parts = line.split()
                    if len(parts) < 2:
                        continue
                    dev, mountpoint = _decode_mount_field(parts[0]), _decode_mount_field(parts[1])
                    if _device_matches(dev, device_name):
                        mount_candidates.append((mountpoint, dev))
        except OSError:
            return None

    if not mount_candidates:
        return None
    mountpoint, source = sorted(mount_candidates, key=lambda item: len(item[0]), reverse=True)[0]
    try:
        usage = shutil.disk_usage(mountpoint)
        return {"mountpoint": mountpoint, "source": source, "total": usage.total, "used": usage.used, "free": usage.free}
    except OSError:
        return None


def discover_cache_set_path(bcache_path):
    if not bcache_path:
        return ""
    direct = os.path.join(bcache_path, "cache")
    if os.path.exists(direct):
        try:
            real = os.path.realpath(direct)
            if os.path.isdir(real):
                return real
        except OSError:
            pass

    stats_path = STATS_TOTAL_PATH or _discover_stats_total_path()
    if stats_path:
        parent = os.path.dirname(stats_path)
        if os.path.isdir(parent):
            return parent

    candidates = sorted(glob.glob("/sys/fs/bcache/*"))
    return candidates[0] if candidates else ""


def read_cache_device_capacity(cache_set_path):
    if not cache_set_path:
        return None
    capacities = []
    for cache_path in sorted(glob.glob(os.path.join(cache_set_path, "cache*"))):
        bucket_size = parse_sysfs_size_bytes(read(os.path.join(cache_path, "bucket_size")))
        buckets = read_int_file(os.path.join(cache_path, "nbuckets"))
        if bucket_size is not None and buckets is not None:
            capacities.append(bucket_size * buckets)
        else:
            dev_name = os.path.basename(os.path.realpath(cache_path))
            capacities.append(read_block_device_size_bytes(dev_name))
    known = [value for value in capacities if value is not None]
    return sum(known) if known else None


def read_block_device_stat(device_name):
    raw = read(f"/sys/block/{device_name}/stat") if device_name else None
    if not raw:
        return None
    parts = raw.split()
    if len(parts) < 7:
        return None
    try:
        return {"read_sectors": int(parts[2]), "write_sectors": int(parts[6])}
    except ValueError:
        return None


def calculate_device_rates(prev_sample, current_stat, now_ts):
    if not prev_sample or not current_stat:
        return None, None
    prev_stat, prev_ts = prev_sample
    elapsed = now_ts - prev_ts
    if elapsed <= 0:
        return None, None
    read_delta = current_stat["read_sectors"] - prev_stat.get("read_sectors", 0)
    write_delta = current_stat["write_sectors"] - prev_stat.get("write_sectors", 0)
    read_rate = read_delta * 512 / elapsed if read_delta >= 0 else None
    write_rate = write_delta * 512 / elapsed if write_delta >= 0 else None
    return read_rate, write_rate


def read_bcache_details(device_name, bcache_path):
    cache_set_path = discover_cache_set_path(bcache_path)
    dirty_bytes = dirty_val()
    cache_capacity = read_cache_device_capacity(cache_set_path)
    cache_available_percent = _parse_percent(read(f"{bcache_path}/cache_available_percent")) if bcache_path else None
    if cache_available_percent is None and cache_set_path:
        cache_available_percent = _parse_percent(read(os.path.join(cache_set_path, "cache_available_percent")))

    cache_available_bytes = None
    if cache_capacity is not None and cache_available_percent is not None:
        cache_available_bytes = cache_capacity * (cache_available_percent / 100.0)

    backing_size = read_block_device_size_bytes(device_name)
    fs_usage = disk_usage_for_device(device_name)
    writeback_rate_sectors = read_int_file(f"{bcache_path}/writeback_rate") if bcache_path else None
    writeback_rate_bytes = writeback_rate_sectors * 512 if writeback_rate_sectors is not None else None

    return {
        "cache_mode": read(f"{bcache_path}/cache_mode") if bcache_path else None,
        "cache_capacity": cache_capacity,
        "cache_available_percent": cache_available_percent,
        "cache_available_bytes": cache_available_bytes,
        "dirty_bytes": dirty_bytes,
        "backing_size": backing_size,
        "fs_usage": fs_usage,
        "writeback_percent": read(f"{bcache_path}/writeback_percent") if bcache_path else None,
        "writeback_rate_bytes": writeback_rate_bytes,
        "writeback_running": read(f"{bcache_path}/writeback_running") if bcache_path else None,
        "cache_set_path": cache_set_path,
        "device_stat": read_block_device_stat(device_name),
        "cache_devices": discover_cache_device_names(cache_set_path),
    }



def discover_cache_device_names(cache_set_path):
    if not cache_set_path:
        return []
    devices = []
    for cache_path in sorted(glob.glob(os.path.join(cache_set_path, "cache*"))):
        real = os.path.realpath(cache_path)
        name = os.path.basename(real)
        if name and name.startswith(("sd", "nvme", "vd", "xvd")):
            devices.append(name)
    return devices


def parse_smart_health_text(stdout):
    health = {"available_spare_percent": None, "wear_used_percent": None, "life_remaining_percent": None, "temperature_c": None, "tbw_bytes": None}
    for line in str(stdout or "").splitlines():
        lower = line.lower()
        _, sep, rhs = line.partition(":")
        if not sep:
            continue
        value = rhs.strip().replace(",", "")
        if "percentage used" in lower or "wear_leveling_count" in lower or "wear leveling count" in lower:
            pct = _parse_percent(value.split()[0] if value.split() else value)
            if pct is not None:
                health["wear_used_percent"] = pct
        elif "available spare" in lower and "threshold" not in lower:
            health["available_spare_percent"] = _parse_percent(value.split()[0] if value.split() else value)
        elif "temperature" in lower and health["temperature_c"] is None:
            parts = value.replace("Celsius", "").replace("°C", "").split()
            try:
                health["temperature_c"] = float(parts[0])
            except (ValueError, IndexError):
                pass
        elif "data units written" in lower:
            try:
                units = int(value.split()[0])
                health["tbw_bytes"] = units * 512000
            except (ValueError, IndexError):
                pass
        elif "total_lbas_written" in lower:
            try:
                health["tbw_bytes"] = int(value.split()[0]) * 512
            except (ValueError, IndexError):
                pass
    if health["wear_used_percent"] is not None:
        health["life_remaining_percent"] = max(0.0, 100.0 - health["wear_used_percent"])
    elif health["available_spare_percent"] is not None:
        health["life_remaining_percent"] = health["available_spare_percent"]
    return health


def missing_dependency_hint(command_name):
    return DEPENDENCY_INSTALL_HINTS.get(command_name, f"Install '{command_name}' to enable related values.")


def smart_dependency_hint(cache_device_names, attempted_tools=None, last_status=""):
    names = list(cache_device_names or [])
    attempted = set(attempted_tools or [])
    if not names:
        return "No cache device found for SSD health values."

    preferred = "nvme" if any(str(name).startswith("nvme") for name in names) else "smartctl"
    if last_status == "NOT INSTALLED" or not attempted:
        return missing_dependency_hint(preferred)
    if last_status.startswith("ERR:"):
        return f"{preferred} is installed but returned {last_status}; run as root or adjust device permissions."
    if last_status == "TIMEOUT":
        return f"{preferred} timed out while reading SSD health values."
    return f"SSD health unavailable; verify {preferred} access and device support."


def base_ssd_health(cache_device_names, source="unavailable", dependency_hint=""):
    return {
        "device": cache_device_names[0] if cache_device_names else "",
        "source": source,
        "dependency_hint": dependency_hint,
        "available_spare_percent": None,
        "wear_used_percent": None,
        "life_remaining_percent": None,
        "temperature_c": None,
        "tbw_bytes": None,
    }


def read_ssd_health(cache_device_names):
    names = list(cache_device_names or [])
    attempted_tools = []
    last_status = ""
    for name in names:
        dev_path = f"/dev/{name}"
        if name.startswith("nvme"):
            attempted_tools.append("nvme")
            result = _run_command(["nvme", "smart-log", dev_path], timeout=2.5)
            last_status = result["status"]
            if result["ok"]:
                health = parse_smart_health_text(result["stdout"])
                health.update({"device": dev_path, "source": "nvme", "dependency_hint": ""})
                return health
        attempted_tools.append("smartctl")
        result = _run_command(["smartctl", "-A", dev_path], timeout=2.5)
        last_status = result["status"]
        if result["ok"]:
            health = parse_smart_health_text(result["stdout"])
            health.update({"device": dev_path, "source": "smartctl", "dependency_hint": ""})
            return health
    return base_ssd_health(names, dependency_hint=smart_dependency_hint(names, attempted_tools, last_status))


def dependency_warnings(smart_health=None, docker_state=""):
    warnings = []
    hint = (smart_health or {}).get("dependency_hint")
    if hint:
        warnings.append(f"SSD health: {hint}")
    if docker_state == "NOT INSTALLED":
        warnings.append(f"Docker: {missing_dependency_hint('docker')}")
    elif docker_state.startswith("ERR:"):
        warnings.append(f"Docker CLI returned {docker_state}; check daemon access/permissions.")
    elif docker_state == "TIMEOUT":
        warnings.append("Docker CLI timed out; container values may be stale or unavailable.")
    return warnings


def efficiency_label(eff):
    if eff >= 90:
        return "Sehr gut"
    if eff >= 80:
        return "Gut"
    if eff >= 50:
        return "Warnung"
    return "Cache bringt kaum Nutzen"


def estimate_flush_seconds(dirty_bytes, flush_rate_bytes):
    if dirty_bytes is None or dirty_bytes <= 0:
        return 0.0
    if not flush_rate_bytes or flush_rate_bytes <= 0:
        return None
    return dirty_bytes / flush_rate_bytes


def format_duration(seconds):
    if seconds is None:
        return "N/A"
    seconds = int(round(seconds))
    minutes, sec = divmod(seconds, 60)
    hours, minutes = divmod(minutes, 60)
    if hours:
        return f"{hours}h {minutes}m"
    if minutes:
        return f"{minutes}m {sec}s"
    return f"{sec}s"


def health_report(eff, details, smart_health, hps=0, mps=0):
    score = 100
    warnings = []
    mode = format_cache_mode(details.get("cache_mode"))
    dirty_bytes = details.get("dirty_bytes")
    if mode in ("none", "N/A"):
        score -= 35; warnings.append("Cache mode inactive")
    if eff < 50:
        score -= 25; warnings.append("Low cache hit rate")
    elif eff < 80:
        score -= 10; warnings.append("Cache efficiency degraded")
    temp = smart_health.get("temperature_c") if smart_health else None
    if temp is not None and temp > 70:
        score -= 35; warnings.append("SSD temperature critical")
    elif temp is not None and temp > 60:
        score -= 15; warnings.append("SSD temperature high")
    life = smart_health.get("life_remaining_percent") if smart_health else None
    if life is not None and life < 15:
        score -= 35; warnings.append("Cache SSD life below 15%")
    elif life is not None and life < 30:
        score -= 15; warnings.append("Cache SSD wear warning")
    wb_pct = _parse_percent(details.get("writeback_percent"))
    if mode == "writeback" and wb_pct is not None and wb_pct > 40:
        score -= 10; warnings.append("High writeback percent")
    if dirty_bytes and dirty_bytes > 50 * 1024 ** 3:
        score -= 10; warnings.append("Large dirty data backlog")
    score = max(0, min(100, int(score)))
    status = "HEALTHY" if score >= 80 else ("WARNING" if score >= 50 else ("CRITICAL" if score >= 20 else "FAILURE"))
    return {"score": score, "status": status, "warnings": warnings or ["No major issues detected"]}


def recommendations(eff, details, smart_health):
    recs = []
    mode = format_cache_mode(details.get("cache_mode"))
    if mode == "none":
        recs.append("Cache mode is none: verify attachment and choose writethrough/writeback/writearound.")
    if eff < 50:
        recs.append("Hit rate is low: check working-set size, cache_available_percent, and sequential_cutoff.")
    elif eff < 80:
        recs.append("Hit rate is below ideal: compare recent workload with historical CSV data.")
    flush_seconds = estimate_flush_seconds(details.get("dirty_bytes"), details.get("writeback_rate_bytes"))
    if mode == "writeback" and flush_seconds is None and details.get("dirty_bytes"):
        recs.append("Dirty data cannot be drained estimate: writeback_rate is unavailable or zero.")
    life = smart_health.get("life_remaining_percent") if smart_health else None
    if life is not None and life < 30:
        recs.append("Plan cache SSD replacement; remaining life is below 30%.")
    temp = smart_health.get("temperature_c") if smart_health else None
    if temp is not None and temp > 60:
        recs.append("Improve airflow or reduce cache load; SSD temperature is elevated.")
    return recs or ["No action required; continue monitoring trends."]



def average(values):
    vals = [float(v) for v in (values or []) if v is not None]
    return sum(vals) / len(vals) if vals else 0.0


def performance_comparison(before_eff, after_eff):
    if before_eff is None or after_eff is None:
        return {
            "before": before_eff,
            "after": after_eff,
            "delta": None,
            "summary": "Not enough data for before/after comparison.",
        }
    delta = after_eff - before_eff
    return {
        "before": before_eff,
        "after": after_eff,
        "delta": delta,
        "summary": f"Before {before_eff:.0f}% -> after {after_eff:.0f}% ({delta:+.0f}%).",
    }


def detect_anomalies(write_history, current_write_rate, multiplier=4.0, minimum_baseline=50 * 1024 * 1024):
    baseline = average(write_history)
    if current_write_rate is None or baseline <= 0:
        return {
            "anomaly": False,
            "baseline": baseline,
            "current": current_write_rate,
            "message": "No write-rate baseline yet.",
        }
    threshold = max(baseline * multiplier, minimum_baseline)
    anomaly = current_write_rate > threshold
    message = (
        f"Unusual write load: {format_io_rate(current_write_rate)} vs baseline {format_io_rate(baseline)}."
        if anomaly else "Write load is within the learned baseline."
    )
    return {
        "anomaly": anomaly,
        "baseline": baseline,
        "current": current_write_rate,
        "threshold": threshold,
        "message": message,
    }


def docker_top_io(docker_io_rates, limit=3):
    rows = []
    for name, rates in (docker_io_rates or {}).items():
        read_rate, write_rate = rates
        total = (read_rate or 0) + (write_rate or 0)
        rows.append({
            "name": name,
            "read_rate": read_rate or 0,
            "write_rate": write_rate or 0,
            "total_rate": total,
        })
    rows.sort(key=lambda item: item["total_rate"], reverse=True)
    total_all = sum(item["total_rate"] for item in rows)
    for item in rows:
        item["share_percent"] = (item["total_rate"] / total_all * 100.0) if total_all > 0 else 0.0
    return rows[:limit]


def cache_size_advice(details):
    cache_bytes = details.get("cache_capacity") or details.get("cache_size_bytes") or 0
    backing_bytes = details.get("backing_size") or 0
    if cache_bytes <= 0 or backing_bytes <= 0:
        return {
            "status": "unknown",
            "message": "Cache-size advice needs readable cache and backing sizes.",
        }
    recommended = max(64 * 1024 ** 3, min(256 * 1024 ** 3, int(backing_bytes * 0.10)))
    delta = cache_bytes - recommended
    if abs(delta) < 8 * 1024 ** 3:
        status = "ok"
        message = f"Cache size looks balanced ({format_bytes(cache_bytes)})."
    elif delta > 0:
        status = "oversized"
        message = (
            f"Cache may be oversized: {format_bytes(cache_bytes)} current, "
            f"{format_bytes(recommended)} recommended, {format_bytes(delta)} potential saving."
        )
    else:
        status = "undersized"
        message = f"Cache may be too small: {format_bytes(cache_bytes)} current, {format_bytes(recommended)} recommended."
    return {
        "status": status,
        "current_bytes": cache_bytes,
        "recommended_bytes": recommended,
        "delta_bytes": delta,
        "message": message,
    }


def maintenance_guard(details, smart_health):
    blockers = []
    dirty = details.get("dirty_bytes") or 0
    if dirty > 0:
        blockers.append(f"{format_bytes(dirty)} dirty data present")
    if (
        smart_health
        and smart_health.get("life_remaining_percent") is not None
        and smart_health["life_remaining_percent"] < 15
    ):
        blockers.append("cache SSD life below 15%")
    if smart_health and smart_health.get("temperature_c") is not None and smart_health["temperature_c"] > 70:
        blockers.append("cache SSD temperature critical")
    message = "Upgrade/maintenance safe." if not blockers else "Wait before maintenance: " + "; ".join(blockers)
    return {"safe": not blockers, "blockers": blockers, "message": message}


def life_prediction(smart_health, years_at_current_rate=2.8):
    life = smart_health.get("life_remaining_percent") if smart_health else None
    if life is None:
        return "SSD lifetime prediction needs SMART/NVMe life data."
    if life <= 0:
        return "SSD life appears exhausted; replace immediately."
    estimated_years = max(0.1, (life / 100.0) * years_at_current_rate / 0.7)
    return f"Estimated remaining SSD lifetime: about {estimated_years:.1f} years (trend estimate, verify with SMART history)."


def auto_tuning_suggestions(eff, details, anomaly=None):
    suggestions = []
    mode = format_cache_mode(details.get("cache_mode"))
    wb_pct = _parse_percent(details.get("writeback_percent"))
    if eff < 80:
        suggestions.append({
            "setting": "sequential_cutoff",
            "from": "current",
            "to": "higher (for example 16M)",
            "reason": "Improve hit rate when sequential reads bypass cache too aggressively.",
        })
    if mode == "writeback" and wb_pct is not None and wb_pct < 20 and not (anomaly or {}).get("anomaly"):
        suggestions.append({
            "setting": "writeback_percent",
            "from": str(int(wb_pct)),
            "to": "20",
            "reason": "Allow more writeback buffering when dirty-data risk is low.",
        })
    if mode in ("none", "N/A"):
        suggestions.append({
            "setting": "cache_mode",
            "from": mode,
            "to": "writethrough/writeback",
            "reason": "Cache is inactive.",
        })
    return suggestions or [{
        "setting": "none",
        "from": "-",
        "to": "-",
        "reason": "No tuning change recommended from current snapshot.",
    }]


def automatic_diagnosis(eff_history, eff, hps, mps, details, smart_health, docker_io_rates=None):
    previous = average(list(eff_history or [])[:-1]) if eff_history and len(eff_history) > 1 else None
    causes = []
    if mps > hps and (hps + mps) > 0:
        causes.append((False, "Many cache misses / possible sequential or cold workload"))
    if details.get("cache_available_percent") is not None and details["cache_available_percent"] < 5:
        causes.append((False, "Cache SSD available writeback space is nearly full"))
    if docker_top_io(docker_io_rates or {}, 1):
        top = docker_top_io(docker_io_rates, 1)[0]
        if top["share_percent"] >= 50:
            causes.append((True, f"Container {top['name']} causes {top['share_percent']:.0f}% of visible container I/O"))
    if smart_health and smart_health.get("temperature_c") and smart_health["temperature_c"] > 60:
        causes.append((False, "Cache SSD temperature is high"))
    problem = eff < 70 or (previous is not None and eff < previous * 0.65)
    recommendation = "Increase sequential_cutoff and compare before/after hit rate." if eff < 80 else "Continue monitoring; no immediate action required."
    if details.get("dirty_bytes"):
        recommendation = "Wait for dirty data to drain before risky maintenance."
    return {
        "problem": problem,
        "previous_eff": previous,
        "current_eff": eff,
        "causes": causes or [(True, "No obvious root cause found in current snapshot")],
        "recommendation": recommendation,
    }


def raspberry_pi_status():
    uasp = "unknown"
    try:
        drivers = []
        for path in glob.glob("/sys/bus/usb/drivers/*"):
            drivers.append(os.path.basename(path).lower())
        if "uas" in drivers:
            uasp = "yes"
    except OSError:
        pass
    temp = None
    raw = read("/sys/class/thermal/thermal_zone0/temp")
    if raw:
        try:
            temp = float(raw) / 1000.0
        except ValueError:
            temp = None
    io_wait = None
    try:
        with open('/proc/stat', 'r', encoding='utf-8') as src:
            parts = src.readline().split()
        vals = [int(x) for x in parts[1:]]
        total = sum(vals)
        io_wait = (vals[4] / total * 100.0) if total else None
    except (OSError, ValueError, IndexError):
        pass
    return {"uasp": uasp, "cpu_temp_c": temp, "io_wait_percent": io_wait}

def append_history_sample(path, device, eff, details, smart_health, now_ts=None):
