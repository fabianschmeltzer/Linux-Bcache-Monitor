            mem_col_w = min_col_w
        cpu_x = table_start_x + name_col_w
        mem_x = cpu_x + cpu_col_w
        io_x = mem_x + mem_col_w

        safe_addstr(stdscr, y, table_start_x, f"{tr(state, 'name'):<{max(1, name_col_w-1)}}", 4)
