def _graph_points(data, y, x, w, h, maxv):
    if not data or w < 2 or h < 2:
        return []

    d = list(data)[-w:]
    start_col = x + max(0, w - len(d))
    points = []
    for i, val in enumerate(d):
        value = max(0, val)
        if value <= 0:
            points.append((None, start_col + i, value))
            continue
        row = y + h - 1 - int((value / maxv) * (h - 1))
        row = max(y, min(y + h - 1, row))
        points.append((row, start_col + i, value))
    return points


def draw_line_graph(stdscr, data, y, x, w, h, color, maxv):
    points = _graph_points(data, y, x, w, h, maxv)
    if len(points) < 2:
        return

    visible = [(row, col, value) for row, col, value in points if row is not None]
    if not visible:
        return

    for row, col, _ in visible[:-1]:
        safe_addstr(stdscr, row, col, "•", color)

    latest_row, latest_col, latest_value = points[-1]
    if latest_row is not None:
        safe_addstr(stdscr, latest_row, latest_col, "◆", color)
    else:
        last_row, last_col, _ = visible[-1]
        if latest_value > 0:
            safe_addstr(stdscr, last_row, last_col, "◆", color)


def draw_x_axis(stdscr, y, x, w):
    if w < 2:
        return
    safe_addstr(stdscr, y, x, "└" + ("─" * (w - 1)), 4)

def draw_y_markers(stdscr, y, x, h, maxv):
    ticks = []
    for i in range(5):
        off = int(round((h - 1) * (i / 4)))
        value = maxv * (1 - (i / 4))
        ticks.append((off, value))
    for off, value in ticks:
        r = y + off
        safe_addstr(stdscr, r, x, "┤", 4)
        safe_addstr(stdscr, r, x - 7, f"{int(value):>6}", 4)

def draw_meter(value, width, color, empty_color=4, empty_char="░"):
    if width <= 0:
        return "", ""
    clamped = max(0.0, min(value, 100.0))
    filled = int(round((clamped / 100.0) * width))
    return "█" * filled, empty_char * max(0, width - filled)

def pct_change(current, baseline):
    if baseline <= 0:
        return 0.0
    return ((current - baseline) / baseline) * 100.0

def trend_arrow(current, baseline):
    if baseline <= 0 and current > 0:
        return "↑"
    if baseline <= 0:
        return "→"
    if current > baseline:
        return "↑"
    if current < baseline:
        return "↓"
    return "→"

