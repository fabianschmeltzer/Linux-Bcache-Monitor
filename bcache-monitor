        if not exists:
            writer.writerow(["timestamp", "device", "hit_rate_percent", "dirty_bytes", "cache_mode", "ssd_life_percent", "ssd_temp_c"])
        writer.writerow([int(now_ts), device or "", f"{eff:.2f}", details.get("dirty_bytes") or 0, format_cache_mode(details.get("cache_mode")), smart_health.get("life_remaining_percent") if smart_health else "", smart_health.get("temperature_c") if smart_health else ""])


def prometheus_metrics(device, eff, details, smart_health, report):
    labels = f'device="{device or "unknown"}"'
    mode = format_cache_mode(details.get("cache_mode"))
    mode_state = 0 if mode in ("none", "N/A") else 1
