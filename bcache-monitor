def draw_info(stdscr, state):
    scroll = 0
    while True:
        stdscr.erase()
        maxy, maxx = stdscr.getmaxyx()
        safe_addstr(stdscr, 0, 1, "INFO | Q/Esc zurück | ↑↓ scroll | PgUp/PgDn", 4)
        width = max(20, maxx - 4)
        wrapped = []
        for line in info_lines(state):
            if not line:
                wrapped.append("")
            else:
                wrapped.extend(textwrap.wrap(line, width=width) or [""])
        visible_h = max(1, maxy - 2)
        scroll = max(0, min(scroll, max(0, len(wrapped) - visible_h)))
        for idx, line in enumerate(wrapped[scroll:scroll + visible_h]):
            safe_addstr(stdscr, idx + 1, 1, line[:width], 0)
        if len(wrapped) > visible_h:
            safe_addstr(stdscr, maxy - 1, 1, f"{scroll + 1}-{min(scroll + visible_h, len(wrapped))}/{len(wrapped)}", 4)
        stdscr.refresh()
        ch = stdscr.getch()
        if ch in [27, ord('q'), ord('Q'), ord('i'), ord('I')]:
            return
        if ch in [curses.KEY_DOWN, ord('j')]:
            scroll += 1
        elif ch in [curses.KEY_UP, ord('k')]:
            scroll -= 1
        elif ch == curses.KEY_NPAGE:
            scroll += visible_h
        elif ch == curses.KEY_PPAGE:
            scroll -= visible_h

def draw_main(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)

    update_notice = ""
    updated_from = os.environ.get("BCACHE_MONITOR_UPDATED_FROM", "").strip()
    updated_to = os.environ.get("BCACHE_MONITOR_UPDATED_TO", "").strip()
    if updated_from and updated_to:
        update_notice = f"UPDATED: {updated_from} -> {updated_to}"

    ph,pm=stats()
    if ph is None or pm is None:
        ph, pm = 0, 0
    config, config_notice = load_config()
    state = AppState(config=config, config_notice=config_notice, update_notice=update_notice, selected_containers=list(config.get("containers", [])), ph=ph, pm=pm, pt=time.time())
    refresh_device_selection(state)

    while True:
        stdscr.erase()
        maxy,maxx=stdscr.getmaxyx()

        refresh_device_selection(state)
        if not state.device_path:
            safe_addstr(stdscr, 0, 0, "No bcache device found (set BCACHE_MONITOR_DEVICE)", 1)
            if state.available_devices:
                safe_addstr(stdscr, 1, 0, f"Available: {', '.join(state.available_devices)}", 3)
            safe_addstr(stdscr, 2, 0, "Q=quit")
            stdscr.refresh()
            if stdscr.getch() in [ord('q'),ord('Q')]:
                break
            time.sleep(1)
            continue

        tiny_mode = maxy < 18 or maxx < 64
        compact_mode = maxy < 22 or maxx < 80
        narrow_mode = maxx < 120

        # DATA
        if not state.device_path:
            safe_addstr(stdscr,0,1,f"BCACHE OBSERVABILITY v{__version__}",4)
            safe_addstr(stdscr,2,1,"ERROR: Kein bcache-Gerät verfügbar.",1)
            safe_addstr(stdscr,3,1,"Erwartet wird ein Pfad wie /sys/block/<device>/bcache.",3)
            safe_addstr(stdscr,4,1,"Bitte prüfen, ob bcache aktiv ist und das Device eingebunden wurde.",3)
            safe_addstr(stdscr,maxy-1,1,"Q=quit")
            stdscr.refresh()
            if stdscr.getch() in [ord('q'),ord('Q')]:
                break
            time.sleep(1)
            continue

        h0,m0=stats()
        sysfs_ok = not (h0 is None or m0 is None)
        if not sysfs_ok:
            h0, m0 = state.ph, state.pm
        now=time.time()
        dt=max(now-state.pt, MIN_RATE_SAMPLE_SECONDS)

        hps=int((h0-state.ph)/dt); mps=int((m0-state.pm)/dt)
        state.ph,state.pm,state.pt=h0,m0,now
        state.hits.append(hps); state.miss.append(mps); state.miss_trend.append(mps)

        eff=h0/(h0+m0)*100 if (h0+m0) else 0
        details = read_bcache_details(state.device_name, state.device_path)
        dirty_bytes = details["dirty_bytes"]
        dirty_display=format_dirty_value(dirty_bytes)

        # -------- HEADER --------
        safe_addstr(stdscr,0,1,f"HEADER | BCACHE OBSERVABILITY v{__version__} | DEVICE {state.device_name or 'N/A'}",6)

        # -------- KPI BLOCK --------
        ratio = (mps / hps) if hps > 0 else (float("inf") if mps > 0 else 0.0)
        ratio_text = "∞" if ratio == float("inf") else f"{ratio:.2f}"
        safe_addstr(stdscr,2,1,f"KPI   | EFF {eff:.1f}%   DIRTY {dirty_display}   MISS/HIT {ratio_text}")
        source_text = f"KPI   | LIVE HIT/s {hps}   MISS/s {mps}   SOURCE {state.device_source}"
        if maxx >= 96:
            source_text += " (config/env/auto)"
        safe_addstr(stdscr,3,1,source_text)

        # -------- GRAPH --------
        footer_reserved = 2
        graph_min_h = 4 if compact_mode else 6
        graph_max_fraction = 0.34 if narrow_mode else 0.32
        graph_max_h = 12 if compact_mode else 16
        # Container-Bereich früher sichtbar machen: feste Reserve für Health + Container-Header/Tabelle.
        reserved_after_graph = 8 if compact_mode else (13 if narrow_mode else 12)
        graph_h = max(
            graph_min_h,
            min(
                maxy - reserved_after_graph - footer_reserved,
                int(maxy * graph_max_fraction),
                graph_max_h,
            ),
        )
        graph_y = 5
        graph_x = 8
        available_graph_w = maxx - graph_x - 1
        graph_w = max(1, available_graph_w)
        if available_graph_w >= 20:
            graph_w = max(20, graph_w)
        raw_maxv = max(max(state.hits) if state.hits else 0, max(state.miss) if state.miss else 0, 1)
        target_maxv = FIXED_MAX_PS if FIXED_MAX_PS > 0 else raw_maxv
        state.graph_scale = 0.35 * target_maxv + 0.65 * state.graph_scale
        maxv = max(int(state.graph_scale), 1)

        draw_y_markers(stdscr, graph_y, graph_x - 1, graph_h, maxv)
        draw_x_axis(stdscr, graph_y + graph_h - 1, graph_x, graph_w)
        draw_line_graph(stdscr, state.miss, graph_y, graph_x, graph_w, graph_h, 1, maxv)
        draw_line_graph(stdscr, state.hits, graph_y, graph_x, graph_w, graph_h, 2, maxv)
        if compact_mode:
            graph_legend = "GRAPH | red=MISS/s green=HIT/s"
        else:
            graph_legend = f"GRAPH | red=MISS/s | green=HIT/s | Scale {maxv}/s | ◆ latest non-zero | • history"
        safe_addstr(stdscr, graph_y - 1, graph_x, graph_legend, 6)
        point_help = "Points: 1 point = 1s | zero values stay on the axis to avoid fake traffic"
        safe_addstr(stdscr, graph_y + graph_h + 1, graph_x, point_help, 6)

        avg_h = (sum(state.hits) / len(state.hits)) if state.hits else 0
        avg_m = (sum(state.miss) / len(state.miss)) if state.miss else 0
        max_h = max(state.hits) if state.hits else 0
        max_m = max(state.miss) if state.miss else 0
        miss_share = (mps / (hps + mps) * 100.0) if (hps + mps) > 0 else 0.0
        # Legend for values: current / average / peak
        h_part = f"H {hps:>4}/{avg_h:>4.0f}/{max_h:>4}"
        m_part = f"M {mps:>4}/{avg_m:>4.0f}/{max_m:>4}"
        hit_share = (hps / (hps + mps) * 100.0) if (hps + mps) > 0 else 0.0
        mix_part = f"MIX M:{miss_share:>5.1f}% H:{hit_share:>5.1f}%" if (hps + mps) > 0 else "MIX idle"
        delta_part = f"Δ M:{format_delta_pct(mps, avg_m)} H:{format_delta_pct(hps, avg_h)}"
        safe_addstr(stdscr, graph_y + graph_h + 2, graph_x, h_part, 2)
        x_off = graph_x + len(h_part)
        safe_addstr(stdscr, graph_y + graph_h + 2, x_off, " | ", 6)
        x_off += 3
        safe_addstr(stdscr, graph_y + graph_h + 2, x_off, m_part, 1)
        x_off += len(m_part)
        safe_addstr(stdscr, graph_y + graph_h + 2, x_off, f" | {mix_part} | {delta_part}", 6)
        safe_addstr(stdscr, graph_y + graph_h + 3, graph_x, "H/M format: current/s / average/s / peak/s", 6)
        if not tiny_mode:
            safe_addstr(stdscr, graph_y + graph_h + 4, graph_x, f"window {min(len(state.hits), graph_w)}s (buffer {HISTORY}s)", 6)

        # -------- STATUS --------
        status,color,reason=status_from_metrics(eff,hps,mps,state.miss_trend)
        safe_addstr(stdscr,4+graph_h+1,1,f"HEALTH | PRIMARY ALERT: {status} ({reason})",color)
        eff_arrow = trend_arrow(eff, avg_h and (h0/(h0+m0)*100 if (h0+m0) else eff))
        ratio_arrow = trend_arrow(mps, avg_m)
        if not tiny_mode:
            health_text = f"HEALTH | EFF {eff:.1f}%{eff_arrow} crit<{EFF_CRITICAL_THRESHOLD:.0f} | MISS/HIT {ratio_text}{ratio_arrow} crit≥{MISS_HIT_RATIO_CRITICAL:.2f}"
            safe_addstr(stdscr,4+graph_h+2,1,health_text, color)
        if len(state.hits) >= 10 and len(state.miss) >= 10:
            short_h = sum(list(state.hits)[-10:]) / 10
            short_m = sum(list(state.miss)[-10:]) / 10
        else:
            short_h = avg_h
            short_m = avg_m
        if not compact_mode:
            safe_addstr(stdscr,graph_y+graph_h+4,1,f"10s AVG -> H:{short_h:.0f}/s  M:{short_m:.0f}/s  ΔMISS:{format_delta_pct(short_m, avg_m)} vs window",4)

        if compact_mode:
            safe_addstr(stdscr, graph_y + graph_h + 4, 1, "COMPACT MODE | Core metrics prioritized", 3)
            if state.update_notice: safe_addstr(stdscr,maxy-2,1,state.update_notice,3)
            if state.config_notice: safe_addstr(stdscr,maxy-2,1,state.config_notice,3)
            elif state.device_warning: safe_addstr(stdscr,maxy-2,1,state.device_warning,3)
            safe_addstr(stdscr,maxy-1,1,"FOOTER/HOTKEYS | Q quit | S settings | R reload | I info",4)
            stdscr.refresh()
            action = handle_keypress(stdscr.getch(), state)
            if action == "quit": break
            if action == "settings": draw_settings(stdscr, state)
            if action == "info": draw_info(stdscr, state)
            time.sleep(FRAME_SECONDS)
            continue

        # -------- CONTAINERS --------
        y = graph_y+graph_h+5
        stats_right_x = 32 if maxx >= 100 else max(1, maxx // 2)
        safe_addstr(stdscr,y,1,"CACHE NUMBERS",4)
        y += 1
        safe_addstr(stdscr,y,1,f"Total Hits:   {h0:,}")
        safe_addstr(stdscr,y,stats_right_x,f"Total Misses: {m0:,}")
        y += 1
        safe_addstr(stdscr,y,1,f"Efficiency:   {eff:6.2f}%")
        safe_addstr(stdscr,y,stats_right_x,f"Miss/Hit:     {ratio_text}")
        y += 1
        safe_addstr(stdscr,y,1,f"Peak Hit/s:   {max_h:>6}")
        safe_addstr(stdscr,y,stats_right_x,f"Peak Miss/s:  {max_m:>6}")
        y += 1
        safe_addstr(stdscr,y,1,f"Mode:         {format_cache_mode(details['cache_mode'])}")
        safe_addstr(stdscr,y,stats_right_x,f"WB rate:      {format_io_rate(details['writeback_rate_bytes'])}")
        y += 1
        safe_addstr(stdscr,y,1,f"SSD cache:    {format_bytes(details['cache_capacity'])}")
        safe_addstr(stdscr,y,stats_right_x,f"Avail WB:     {format_pct(details['cache_available_percent'])} {format_bytes(details['cache_available_bytes'])}")
        y += 1
        fs_usage = details['fs_usage']
        hdd_text = format_bytes(fs_usage['total']) if fs_usage else format_bytes(details['backing_size'])
        hdd_used = f"used {format_bytes(fs_usage['used'])} free {format_bytes(fs_usage['free'])}" if fs_usage else "used/free N/A"
        safe_addstr(stdscr,y,1,f"HDD/backing:  {hdd_text}")
        safe_addstr(stdscr,y,stats_right_x,hdd_used)
        y += 2
        safe_addstr(stdscr,y,1,"CONTAINERS",4)
        y+=1

        if now - state.docker_last >= DOCKER_REFRESH_SECONDS:
            state.docker_cache, state.docker_state = list_container_stats(state.selected_containers)
            state.docker_last = now

        selection_label = f"{len(state.selected_containers)} selected" if state.selected_containers else "ALL (empty selection)"
        safe_addstr(stdscr, y, 1, f"Containers: {selection_label}", 4)
        y += 1
        data_line = f"DATA: SYSFS {'OK' if sysfs_ok else 'MISSING'} | DOCKER {state.docker_state}"
        if narrow_mode:
            safe_addstr(stdscr, y, 1, data_line, 4)
            y += 1
        else:
            safe_addstr(stdscr,y,32,data_line,4)
            y += 1
        y += 1
        table_start_x = 1

        table_usable_w = max(1, maxx - table_start_x - 1)
        names = [name for name, _, _, _, _ in state.docker_cache] or ["NAME"]
        longest_name = max(len(n) for n in names)
        name_col_w = min(max(12, longest_name + 2), max(12, int(table_usable_w * (0.35 if narrow_mode else 0.34))))
        metrics_w = max(36, table_usable_w - name_col_w)
        cpu_col_w = max(10, metrics_w // 3)
        mem_col_w = max(10, metrics_w // 3)
        io_col_w = max(10, metrics_w - cpu_col_w - mem_col_w)
        min_col_w = 10
        if cpu_col_w < min_col_w:
            shift = min_col_w - cpu_col_w
            cpu_col_w += shift
            mem_col_w = max(min_col_w, mem_col_w - shift)
        if mem_col_w < min_col_w:
            mem_col_w = min_col_w
        cpu_x = table_start_x + name_col_w
        mem_x = cpu_x + cpu_col_w
        io_x = mem_x + mem_col_w

        safe_addstr(stdscr, y, table_start_x, f"{'NAME':<{max(1, name_col_w-1)}}", 4)
        safe_addstr(stdscr, y, cpu_x, "CPU", 4)
        safe_addstr(stdscr, y, mem_x, "RAM", 4)
        safe_addstr(stdscr, y, io_x, "DISK", 4)
        y += 1
        if (maxy - 2) - y < 1:
            safe_addstr(stdscr, y, table_start_x, "Nicht genug Platz für Containeranzeige.", 3)
        now_ts = time.time()
        current_io_totals = {}
        for name,cpu,mem,mem_usage_raw,block_io_raw in state.docker_cache:
            if y+1 >= maxy:
                break
            cpu_room = max(0, cpu_col_w - 10)
            mem_room = max(0, mem_col_w - 11)
            mem_bytes = parse_docker_mem_usage_bytes(mem_usage_raw)
            mem_text = format_dirty_value(mem_bytes) if mem_bytes is not None else "N/A"
            read_bytes, write_bytes = parse_docker_block_io_pair(block_io_raw)

            read_rate = None
            write_rate = None
            if read_bytes is not None or write_bytes is not None:
                current_io_totals[name] = ((read_bytes or 0, write_bytes or 0), now_ts)
                prev_sample = state.docker_io_prev.get(name)
                if prev_sample:
                    prev_totals, prev_ts = prev_sample
                    if isinstance(prev_totals, tuple):
                        prev_read, prev_write = prev_totals
                    else:
                        prev_read, prev_write = prev_totals, 0
                    elapsed = now_ts - prev_ts
                    read_delta = (read_bytes or 0) - prev_read
                    write_delta = (write_bytes or 0) - prev_write
                    if elapsed > 0 and read_delta >= 0:
                        read_rate = read_delta / elapsed
                    if elapsed > 0 and write_delta >= 0:
                        write_rate = write_delta / elapsed
            if io_col_w >= 26:
                io_text = f"R {format_io_rate(read_rate)} W {format_io_rate(write_rate)}"
            else:
                total_rate = None if read_rate is None and write_rate is None else (read_rate or 0) + (write_rate or 0)
                io_text = format_io_rate(total_rate)
            bar_cpu, bar_cpu_empty = draw_meter(cpu, cpu_room, 2, empty_char=" ")
            bar_mem, bar_mem_empty = draw_meter(mem, mem_room, 3, empty_char=" ")

            max_name_len = max(6, name_col_w - 2)
            disp_name = name if len(name) <= max_name_len else name[:max_name_len-1] + "…"
            safe_addstr(stdscr,y,table_start_x,f"{disp_name:<{name_col_w-1}}")
            safe_addstr(stdscr,y,cpu_x,f"C {cpu:5.1f}% ",6)
            safe_addstr(stdscr,y,cpu_x + 9,bar_cpu,2)
            safe_addstr(stdscr,y,cpu_x + 9 + len(bar_cpu),bar_cpu_empty,6)
            safe_addstr(stdscr,y,mem_x,f"R {mem_text:>8} ",6)
            safe_addstr(stdscr,y,mem_x + 11,bar_mem,3)
            safe_addstr(stdscr,y,mem_x + 11 + len(bar_mem),bar_mem_empty,6)
            safe_addstr(stdscr,y,io_x,f"D {io_text}",6)
            y+=1
        state.docker_io_prev = current_io_totals

        if state.update_notice: safe_addstr(stdscr,maxy-2,1,state.update_notice,3)
        if state.config_notice: safe_addstr(stdscr,maxy-2,1,state.config_notice,3)
        elif state.device_warning: safe_addstr(stdscr,maxy-2,1,state.device_warning,3)
        safe_addstr(stdscr,maxy-1,1,"FOOTER/HOTKEYS | Q quit | S settings | R reload | I info",4)

        stdscr.refresh()

        key = stdscr.getch()
        if key == curses.KEY_RESIZE:
            continue
        action = handle_keypress(key, state)
        if action == "quit": break
        if action == "settings": draw_settings(stdscr, state)
        if action == "info": draw_info(stdscr, state)

        time.sleep(FRAME_SECONDS)

def print_version_and_exit_if_requested(argv):
    if any(arg in ("--version", "-V") for arg in argv[1:]):
        print(__version__)
        return True
    return False


def main():
    if print_version_and_exit_if_requested(sys.argv):
        return

    updated_from = os.environ.get("BCACHE_MONITOR_UPDATED_FROM")
    updated_to = os.environ.get("BCACHE_MONITOR_UPDATED_TO")
    if updated_from and updated_to:
        print_update_event(f"Update erfolgreich angewendet: {updated_from} -> {updated_to}")
        time.sleep(1)

    self_update_if_needed()
    curses.wrapper(init)

def init(stdscr):
    curses.start_color()
    curses.init_pair(1,curses.COLOR_RED,curses.COLOR_BLACK)
    curses.init_pair(2,curses.COLOR_GREEN,curses.COLOR_BLACK)
    curses.init_pair(3,curses.COLOR_YELLOW,curses.COLOR_BLACK)
    curses.init_pair(4,curses.COLOR_CYAN,curses.COLOR_BLACK)
    curses.init_pair(6,curses.COLOR_WHITE,curses.COLOR_BLACK)
    draw_main(stdscr)

if __name__=="__main__":
    main()
