def read(p):
    try:
        return open(p).read().strip()
    except (FileNotFoundError, PermissionError, OSError):
        return None

def parse_version(v):
    try:
        token = normalize_version_string(v)
        return tuple(int(part) for part in token.split("."))
    except:
        return (0,)

def read_remote_text(url):
    if not url:
        return ""
    try:
        with urllib.request.urlopen(url, timeout=3) as r:
            return r.read().decode("utf-8").strip()
    except:
        return ""

def read_remote_bytes(url):
    if not url:
        return b""
    try:
        with urllib.request.urlopen(url, timeout=3) as r:
            return r.read()
    except:
        return b""


def extract_script_version(script_content):
    for line in script_content.splitlines():
        stripped = line.strip()
        if stripped.startswith("__version__"):
            _, _, rhs = stripped.partition("=")
            return normalize_version_string(rhs.strip().strip('"\''))
    return ""


def validate_update_script(script_bytes):
    if not script_bytes:
        return None, "Could not download script"

    script_size = len(script_bytes)
    if script_size < MIN_SCRIPT_SIZE_BYTES or script_size > MAX_SCRIPT_SIZE_BYTES:
        return None, "invalid script size"

    script_content = script_bytes.decode("utf-8", errors="replace")
    if not script_content.startswith("#!/usr/bin/env python3"):
        return None, "invalid script header"

    downloaded_version = extract_script_version(script_content)
    if not is_valid_version_string(downloaded_version):
        return None, "Script does not contain a valid __version__"

    return script_content, ""

def print_update_event(message):
    ts = time.strftime("%H:%M:%S")
    print(f"[bcache-monitor][{ts}] {message}", flush=True)


def get_update_fail_count():
    raw = os.environ.get(UPDATE_FAIL_COUNT_ENV, "0").strip()
    try:
        return max(0, int(raw))
    except:
        return 0


def set_update_fail_count(value):
    os.environ[UPDATE_FAIL_COUNT_ENV] = str(max(0, int(value)))


def mark_update_failure(reason):
    fail_count = get_update_fail_count() + 1
    set_update_fail_count(fail_count)
    print_update_event(f"Update failed ({fail_count}/{MAX_UPDATE_FAILURES}): {reason}")
    if fail_count >= MAX_UPDATE_FAILURES:
        print_update_event("Update strategy locked: 3 failed attempts reached, starting installed version without update")


def reset_update_fail_count():
    if get_update_fail_count() > 0:
        set_update_fail_count(0)

def self_update_if_needed():
    fail_count = get_update_fail_count()
    if fail_count >= MAX_UPDATE_FAILURES:
        print_update_event("Update skipped: failure limit reached")
        return False

    recently_updated_to = normalize_version_string(os.environ.get("BCACHE_MONITOR_UPDATED_TO", ""))
    if recently_updated_to:
        if parse_version(recently_updated_to) >= parse_version(__version__):
            print_update_event(
                f"Update check skipped after restart (local {__version__}, last updated to {recently_updated_to})"
            )
            return False

    remote_version_raw = read_remote_text(VERSION_URL)
    remote_version = normalize_version_string(remote_version_raw)
    remote_version_valid = is_valid_version_string(remote_version)

    script_bytes = b""
    script_content = ""
    downloaded_version = ""

    if remote_version_valid and parse_version(remote_version) > parse_version(__version__):
        print_update_event(f"Update available: {__version__} -> {remote_version}")
        script_bytes = read_remote_bytes(SCRIPT_URL)
    elif not remote_version_valid:
        print_update_event(f"Remote VERSION invalid ('{remote_version_raw}'), checking script version as fallback")
        script_bytes = read_remote_bytes(SCRIPT_URL)
    else:
        # Some deployments have shipped a stale VERSION file while the script
        # itself already contains a newer __version__.  Check the script too so
        # automatic updates do not get stuck behind stale release metadata.
        script_bytes = read_remote_bytes(SCRIPT_URL)

    if script_bytes:
        script_content, validation_error = validate_update_script(script_bytes)
        if validation_error:
            mark_update_failure(validation_error)
            return False
        downloaded_version = extract_script_version(script_content)

        if remote_version_valid and parse_version(remote_version) > parse_version(__version__):
            if parse_version(downloaded_version) != parse_version(remote_version):
                mark_update_failure(f"Version mismatch Script={downloaded_version} Remote={remote_version}")
                return False
        elif parse_version(downloaded_version) > parse_version(__version__):
            print_update_event(f"Update available from script version: {__version__} -> {downloaded_version}")
            remote_version = downloaded_version
        else:
            reset_update_fail_count()
            return False
    else:
        if not remote_version_valid:
            mark_update_failure(f"invalid remote version '{remote_version_raw}' and could not download script")
        elif parse_version(remote_version) > parse_version(__version__):
            mark_update_failure("Could not download script")
        else:
            reset_update_fail_count()
        return False

    script_path = os.path.realpath(__file__)
    temp_path = f"{script_path}.tmp"

    try:
        current_mode = os.stat(script_path).st_mode & 0o777

        with open(temp_path, "w", encoding="utf-8") as dst:
            dst.write(script_content)
            dst.flush()
            os.fsync(dst.fileno())

        os.chmod(temp_path, current_mode)
        os.replace(temp_path, script_path)
        reset_update_fail_count()

        os.environ["BCACHE_MONITOR_UPDATED_FROM"] = __version__
        os.environ["BCACHE_MONITOR_UPDATED_TO"] = remote_version
        print_update_event(f"Updating to {remote_version} and restarting...")
        time.sleep(1)
        os.execv(sys.executable, [sys.executable, script_path] + sys.argv[1:])
    except Exception as exc:
        mark_update_failure(str(exc))
    finally:
        try:
            if os.path.exists(temp_path):
                os.remove(temp_path)
        except:
            pass

    return False

def parse_sysfs_size_bytes(raw_value):
    if raw_value is None:
        return None

    token = str(raw_value).strip()
    if not token:
        return None

    token = token.replace(" ", "")
    lower = token.lower()

    i = 0
    while i < len(lower) and (lower[i].isdigit() or lower[i] == "."):
        i += 1

    if i == 0:
        return None

    number = lower[:i]
    suffix = lower[i:]

    try:
        value = float(number)
    except:
        return None

    units = {
        "": 1,
        "b": 1,
        "k": 1024,
        "kb": 1024,
        "kib": 1024,
        "m": 1024 ** 2,
        "mb": 1024 ** 2,
        "mib": 1024 ** 2,
        "g": 1024 ** 3,
        "gb": 1024 ** 3,
        "gib": 1024 ** 3,
    }

    if suffix not in units:
        return None

    return int(value * units[suffix])


def parse_docker_mem_usage_bytes(mem_usage_raw):
    if not mem_usage_raw:
        return None
    left = str(mem_usage_raw).split("/", 1)[0].strip()
    return parse_sysfs_size_bytes(left)

def parse_docker_block_io_bytes(block_io_raw):
    if not block_io_raw:
        return None
    left = str(block_io_raw).split("/", 1)[0].strip()
    return parse_sysfs_size_bytes(left)


def parse_docker_block_io_pair(block_io_raw):
    if not block_io_raw:
        return None, None
    parts = str(block_io_raw).split("/", 1)
    read_bytes = parse_sysfs_size_bytes(parts[0].strip()) if parts else None
    write_bytes = parse_sysfs_size_bytes(parts[1].strip()) if len(parts) > 1 else None
    return read_bytes, write_bytes


def format_io_rate(io_bytes_per_second):
    if io_bytes_per_second is None or io_bytes_per_second < 0:
        return "N/A"

    kib = io_bytes_per_second / 1024
    if kib < 1024:
        return f"{kib:.1f} KiB/s"

    mib = io_bytes_per_second / (1024 ** 2)
    if mib < 1024:
        return f"{mib:.1f} MiB/s"

    gib = io_bytes_per_second / (1024 ** 3)
    return f"{gib:.1f} GiB/s"


def format_dirty_value(dirty_bytes):
    return format_bytes(dirty_bytes)


def format_bytes(value):
    if value is None:
        return "N/A"

    value = float(value)
    if value < 1024:
        return f"{value:.0f} B"

    kib = value / 1024
    if kib < 1024:
        return f"{kib:.1f} KiB"

    mib = value / (1024 ** 2)
    if mib < 1024:
        return f"{mib:.1f} MiB"

    gib = value / (1024 ** 3)
    if gib < 1024:
        return f"{gib:.1f} GiB"

    tib = value / (1024 ** 4)
    return f"{tib:.1f} TiB"


def dirty_val():
    if not BCACHE:
